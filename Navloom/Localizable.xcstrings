{
  "sourceLanguage" : "en",
  "strings" : {
    "%@ %@ Checked boxes make these URL variants count as identical; the trailing “/” always does. Careful with parameters (?…): if the page depends on them (a video, an article…), different bookmarks would be merged." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ %2$@ Les cases cochées font traiter ces variantes d'URL comme identiques ; le « / » final l'est toujours. Attention aux paramètres (?…) : si la page en dépend (une vidéo, un article…), des favoris différents seraient fusionnés."
          }
        }
      }
    },
    "%@ (build %@)" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ (build %2$@)"
          }
        }
      }
    },
    "%@ already contains all the source's web bookmarks." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ contient déjà tous les favoris web de la source."
          }
        }
      }
    },
    "%@ already has exactly the source's bookmarks." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ a déjà exactement les favoris de la source."
          }
        }
      }
    },
    "%@ is now identical to the source" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ est maintenant identique à la source"
          }
        }
      }
    },
    "%@ is open. Quit it completely (Cmd + Q) before writing to its bookmarks: nothing was changed." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ est ouvert. Ferme-le complètement (Cmd + Q) avant d'écrire dans ses favoris : rien n'a été modifié."
          }
        }
      }
    },
    "%@ is open. Quit it completely (Cmd + Q) to be able to add." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ est ouvert. Ferme-le complètement (Cmd + Q) pour pouvoir ajouter."
          }
        }
      }
    },
    "%@ is open. Quit it completely (Cmd + Q) to be able to copy." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ est ouvert. Ferme-le complètement (Cmd + Q) pour pouvoir copier."
          }
        }
      }
    },
    "%@ is open. Quit it completely (Cmd + Q) to be able to delete." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ est ouvert. Ferme-le complètement (Cmd + Q) pour pouvoir supprimer."
          }
        }
      }
    },
    "%@ is open. Quit it completely (Cmd + Q) to be able to restore." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ est ouvert. Ferme-le complètement (Cmd + Q) pour pouvoir restaurer."
          }
        }
      }
    },
    "%@ is open. Quit it completely (Cmd + Q) to be able to write." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ est ouvert. Ferme-le complètement (Cmd + Q) pour pouvoir écrire."
          }
        }
      }
    },
    "%@ will become identical to the source: %@, %@ %@. Backups are created beforehand: you'll be able to roll back from the Backups screen." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ deviendra identique à la source : %2$@, %3$@ %4$@. Des sauvegardes sont créées avant : tu pourras revenir en arrière depuis l'écran Sauvegardes."
          }
        }
      }
    },
    "%@. Arc isn't supported, nor are Safari or Firefox, which don't use the same bookmark format." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@. Arc n'est pas supporté, pas plus que Safari ou Firefox, qui n'utilisent pas le même format de favoris."
          }
        }
      }
    },
    "%lld Google Account bookmarks (cloud icon): they can't be checked, delete them by hand in %@. An account copy protects its group: the local copies can all be checked." : {
      "localizations" : {
        "en" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld Google Account bookmark (cloud icon): it can't be checked, delete it by hand in %@. An account copy protects its group: the local copies can all be checked."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld Google Account bookmarks (cloud icon): they can't be checked, delete them by hand in %@. An account copy protects its group: the local copies can all be checked."
                }
              }
            }
          }
        },
        "fr" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%1$lld favori du compte Google (icône nuage) : il n'est pas cochable, supprime-le à la main dans %2$@. Une copie du compte protège son groupe : les copies locales peuvent toutes être cochées."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%1$lld favoris du compte Google (icône nuage) : ils ne sont pas cochables, supprime-les à la main dans %2$@. Une copie du compte protège son groupe : les copies locales peuvent toutes être cochées."
                }
              }
            }
          }
        }
      }
    },
