        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Système"
          }
        }
      }
    },
    "Target browser" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Navigateur cible"
          }
        }
      }
    },
    "The Bookmarks file doesn't have the expected format." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le fichier Bookmarks n'a pas le format attendu."
          }
        }
      }
    },
    "The bookmarks of %@ (Bookmarks file) will be replaced by the backup from %@. The current state is backed up automatically beforehand." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les favoris de %1$@ (fichier Bookmarks) seront remplacés par la sauvegarde du %2$@. L'état actuel est sauvegardé automatiquement avant."
          }
        }
      }
    },
    "The bookmarks will be added to %@. No bookmark is deleted or modified. Backups are created beforehand." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les favoris seront ajoutés à %@. Aucun favori n'est supprimé ni modifié. Des sauvegardes sont créées avant."
          }
        }
      }
    },
    "The browser" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le navigateur"
          }
        }
      }
    },
    "The checked bookmarks will be removed from %@. A backup of the Bookmarks file is created beforehand." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les favoris cochés seront retirés de %@. Une sauvegarde du fichier Bookmarks est créée avant."
          }
        }
      }
    },
    "The current state is backed up automatically before restoring." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'état actuel est sauvegardé automatiquement avant la restauration."
          }
        }
      }
    },
    "The favicon database of %@ will be replaced by the backup from %@. The current state is backed up automatically beforehand." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La base de favicons de %1$@ sera remplacée par la sauvegarde du %2$@. L'état actuel est sauvegardé automatiquement avant."
          }
        }
      }
    },
    "The icons couldn't be written (%@): the Favicons database wasn't changed. The bookmarks are added without icons." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les icônes n'ont pas pu être écrites (%@) : la base Favicons n'a pas été modifiée. Les favoris sont ajoutés sans icône."
          }
        }
      }
    },
    "The page responds but redirects elsewhere (another site, or the home page). Often a link to update." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La page répond mais renvoie ailleurs (autre site, ou page d'accueil). Souvent un lien à mettre à jour."
          }
        }
      }
    },
    "The previous folder contains %lld backups. If you leave them in place, they won't appear on the Backups screen anymore." : {
      "localizations" : {
        "en" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "The previous folder contains %lld backup. If you leave it in place, it won't appear on the Backups screen anymore."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "The previous folder contains %lld backups. If you leave them in place, they won't appear on the Backups screen anymore."
                }
              }
            }
          }
        },
        "fr" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Le dossier précédent contient %lld sauvegarde. Si tu la laisses sur place, elle n'apparaîtra plus dans l'écran Sauvegardes."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Le dossier précédent contient %lld sauvegardes. Si tu les laisses sur place, elles n'apparaîtront plus dans l'écran Sauvegardes."
                }
              }
            }
          }
        }
      }
    },
    "The previous state is kept in “%@”." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'état précédent est conservé dans « %@ »."
          }
        }
      }
    },
    "The source and the target are the same profile: choose another one." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La source et la cible sont le même profil : choisis-en un autre."
          }
        }
      }
    },
    "The source contains no web bookmarks: a full copy would empty the target. Nothing was changed." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La source ne contient aucun favori web : une copie complète viderait la cible. Rien n'a été modifié."
          }
        }
      }
    },
    "The source icons couldn't be read (%@). The bookmarks are added without icons." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les icônes de la source n'ont pas pu être lues (%@). Les favoris sont ajoutés sans icône."
          }
        }
      }
    },
    "The source or target bookmarks changed since the comparison. Run the comparison again: nothing was changed in the Bookmarks file." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les favoris de la source ou de la cible ont changé depuis la comparaison. Relance la comparaison : rien n'a été modifié dans le fichier Bookmarks."
          }
        }
      }
    },
    "The source or the target has no Favicons database: the bookmarks are added without icons." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La source ou la cible n'a pas de base Favicons : les favoris sont ajoutés sans icône."
          }
        }
      }
    },
    "The target becomes identical to the source: folders, order and names. Target bookmarks that aren't in the source are deleted (a backup is made beforehand)." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La cible devient identique à la source : dossiers, ordre et noms. Les favoris de la cible qui ne sont pas dans la source sont supprimés (une sauvegarde est faite avant)."
          }
        }
      }
    },
    "The target is already identical to the source." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La cible est déjà identique à la source."
          }
        }
      }
    },
    "The target keeps all its bookmarks; only the ones it's missing are added." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La cible garde tous ses favoris ; seuls ceux qui lui manquent sont ajoutés."
          }
        }
      }
    },
    "This %@ profile has no local Bookmarks file (bookmarks saved only in the account?)." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce profil de %@ n'a pas de fichier Bookmarks local (favoris enregistrés uniquement dans le compte ?)."
          }
        }
      }
    },
    "This backup is unreadable: it wasn't applied." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette sauvegarde est illisible : elle n'a pas été appliquée."
          }
        }
      }
    },
    "Timeout, server error, invalid certificate… No conclusion possible: check by hand." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Délai dépassé, erreur serveur, certificat invalide… Impossible de conclure : à contrôler à la main."
          }
        }
      }
    },
