          "stringUnit" : {
            "state" : "translated",
            "value" : "illisible"
          }
        }
      }
    },
    "“System” follows the macOS setting. The other two force the appearance, whatever that setting is." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "« Système » suit le réglage de macOS. Les deux autres forcent l'apparence, quel que soit ce réglage."
          }
