      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Écriture en cours…"
          }
        }
      }
    },
    "faviconsync-report.txt" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "faviconsync-rapport.txt"
          }
        }
