          }
        }
      }
    },
    "Lists the backups created before each write, by tool (FaviconSync, Twins, Ghosts, Echo), and lets you restore one of them." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Liste les sauvegardes créées avant chaque écriture, par outil (FaviconSync, Twins, Ghosts, Echo), et permet de restaurer l'une d'elles."
          }
        }
      }
    },
    "Mobile bookmarks" : {
